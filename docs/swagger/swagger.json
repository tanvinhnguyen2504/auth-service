{
    "swagger": "2.0",
    "info": {
        "description": "Google sign-in, server-side sessions.",
        "title": "Auth Service",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/auth/google/callback": {
            "get": {
                "description": "Verifies state and the ID token, upserts the user, issues the sid + csrf cookies, then 302s to the frontend. Called by Google, never by the SPA.",
                "tags": [
                    "auth"
                ],
                "summary": "Google OAuth callback",
                "parameters": [
                    {
                        "type": "string",
                        "description": "authorization code from Google",
                        "name": "code",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "opaque state, must match the oauth_tx cookie",
                        "name": "state",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "set by Google when the user cancels",
                        "name": "error",
                        "in": "query"
                    }
                ],
                "responses": {
                    "302": {
                        "description": "redirect to FRONTEND_URL/login?error=cancelled|login_failed|forbidden|server_error"
                    }
                }
            }
        },
        "/auth/google/login": {
            "get": {
                "description": "Sets the sealed oauth_tx cookie and 302s to Google. Open this in the browser, not from Swagger UI's \"Try it out\" — it is a navigation, not an XHR.",
                "tags": [
                    "auth"
                ],
                "summary": "Start Google sign-in",
                "responses": {
                    "302": {
                        "description": "redirect to FRONTEND_URL/login?error=server_error"
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "security": [
                    {
                        "CSRFToken": []
                    }
                ],
                "description": "Deletes the session row and clears the sid + csrf cookies. Other devices stay signed in.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Sign out",
                "responses": {
                    "204": {
                        "description": "signed out"
                    },
                    "403": {
                        "description": "FORBIDDEN — csrf header missing or mismatched",
                        "schema": {
                            "$ref": "#/definitions/github_com_nguyentanvinh_auth-be_backend_internal_platform_handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "INTERNAL",
                        "schema": {
                            "$ref": "#/definitions/github_com_nguyentanvinh_auth-be_backend_internal_platform_handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Liveness check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/platform_router.HealthResponse"
                        }
                    }
                }
            }
        },
        "/me": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Current user",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/github_com_nguyentanvinh_auth-be_backend_internal_platform_config.SuccessResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/auth.MeResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "401": {
                        "description": "UNAUTHENTICATED",
                        "schema": {
                            "$ref": "#/definitions/github_com_nguyentanvinh_auth-be_backend_internal_platform_handler.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "auth.MeResponse": {
            "type": "object",
            "properties": {
                "user": {
                    "$ref": "#/definitions/auth.UserResponse"
                }
            }
        },
        "auth.UserResponse": {
            "type": "object",
            "properties": {
                "avatarUrl": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "github_com_nguyentanvinh_auth-be_backend_internal_platform_config.SuccessResponse": {
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer"
                },
                "data": {},
                "metadata": {},
                "session_id": {
                    "type": "string"
                }
            }
        },
        "github_com_nguyentanvinh_auth-be_backend_internal_platform_handler.ErrorBody": {
            "type": "object",
            "properties": {
                "code": {
                    "$ref": "#/definitions/github_com_nguyentanvinh_auth-be_backend_internal_platform_handler.ErrorCode"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "github_com_nguyentanvinh_auth-be_backend_internal_platform_handler.ErrorCode": {
            "type": "string",
            "enum": [
                "VALIDATION_ERROR",
                "UNAUTHENTICATED",
                "FORBIDDEN",
                "RATE_LIMITED",
                "UPSTREAM_ERROR",
                "INTERNAL"
            ],
            "x-enum-varnames": [
                "ECValidationError",
                "ECUnauthenticated",
                "ECForbidden",
                "ECRateLimited",
                "ECUpstreamError",
                "ECInternal"
            ]
        },
        "github_com_nguyentanvinh_auth-be_backend_internal_platform_handler.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/github_com_nguyentanvinh_auth-be_backend_internal_platform_handler.ErrorBody"
                }
            }
        },
        "platform_router.HealthResponse": {
            "type": "object",
            "properties": {
                "env": {
                    "type": "string"
                },
                "ok": {
                    "type": "boolean"
                }
            }
        }
    },
    "securityDefinitions": {
        "CSRFToken": {
            "description": "Echo the value of the `csrf` cookie. Required on every state-changing /api/v1 call.",
            "type": "apiKey",
            "name": "X-CSRF-Token",
            "in": "header"
        }
    }
}