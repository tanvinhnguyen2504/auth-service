
APP_ENV=
PORT=

DATABASE_URL=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=

# Host port the dockerised API is published on (docker compose only).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Public API origin.
BASE_URL=
# Redirect target after login and the only allowed CORS origin.
FRONTEND_URL=

# Absolute session lifetime, and the idle window reset on each authenticated
# request. A session dies at whichever comes first. Defaults: 12h / 30m.
SESSION_TTL=
SESSION_IDLE_TTL=
# Restrict logins to one Google Workspace domain; empty means any account.
GOOGLE_ALLOWED_HD=

# Seals the oauth_tx cookie (and stored API keys in M2).
# Exactly 32 bytes: openssl rand -base64 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
